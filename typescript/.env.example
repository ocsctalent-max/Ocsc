# Copy to .env locally and fill values from your ThaID RP registration.
# Never commit the real .env or client secret.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_REDIRECT_URI=http://localhost:3000/auth/callback
THAID_WELL_KNOWN_URL=https://imauth.bora.dopa.go.th/.well-known/openid-configuration
THAID_SCOPE=openid pid name_en name birthdate address given_name middle_name family_name given_name_en middle_name_en family_name_en gender smartcard_code title title_en ial
# Set this to the registered ThaID introspection URL. Confirm required token format with ThaID.
THAID_INTROSPECT_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/introspect/
