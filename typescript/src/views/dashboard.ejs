<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ThaID RP - Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<main class="container py-4">
  <h1>ผลการเข้าสู่ระบบ ThaID</h1>
  <p class="text-secondary">ตัวอย่างนี้ไม่แสดง access token / refresh token ในหน้าเว็บ</p>
  <section class="card mb-4"><div class="card-body">
    <h2 class="h5">ข้อมูล session</h2>
    <dl class="row mb-0">
      <dt class="col-sm-3">Token type</dt><dd class="col-sm-9"><%= tokenType %></dd>
      <dt class="col-sm-3">Scope</dt><dd class="col-sm-9"><%= scope %></dd>
      <dt class="col-sm-3">หมดอายุ</dt><dd class="col-sm-9"><%= expiresAt %></dd>
    </dl>
  </div></section>
  <section class="card mb-4"><div class="card-body">
    <h2 class="h5">ID token claims ที่ผ่านการตรวจสอบแล้ว</h2>
    <pre class="mb-0"><%= JSON.stringify(claims, null, 2) %></pre>
  </div></section>
  <div class="d-flex flex-wrap gap-2">
    <form method="post" action="/auth/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-primary">Refresh token</button></form>
    <form method="post" action="/auth/introspect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">ตรวจสอบ token</button></form>
    <form method="post" action="/auth/validate-token"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-info">ตรวจสอบ ID token อีกครั้ง</button></form>
    <form method="post" action="/auth/revoke" onsubmit="return confirm('ยืนยันยกเลิก token?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger">Revoke token</button></form>
    <form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-dark">ออกจากระบบ</button></form>
  </div>
  <p class="mt-4"><a href="/">กลับหน้าแรก</a></p>
</main>
</body>
</html>
